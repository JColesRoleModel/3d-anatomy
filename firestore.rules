rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own saved views.
    match /users/{uid}/saves/{saveId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'created', 'updated', 'data'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.data is map;
    }
    // Practice records: time spent on each movement, breath or mudra.
    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['section', 'routine', 'movement', 'duration', 'timestamp'])
        && request.resource.data.section is string && request.resource.data.section.size() <= 100
        && (request.resource.data.routine == null || (request.resource.data.routine is string && request.resource.data.routine.size() <= 100))
        && (request.resource.data.movement == null || (request.resource.data.movement is string && request.resource.data.movement.size() <= 200))
        && request.resource.data.duration is number && request.resource.data.duration > 0 && request.resource.data.duration <= 3600
        && request.resource.data.timestamp is number;
    }
    // Tasks (the to-do list): due-date and general tasks.
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 5000))
        && (!('section' in request.resource.data) || request.resource.data.section in ['due', 'general']);
    }
    // Watch library: one document per video (id = YouTube video id).
    match /users/{uid}/library/{videoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.ring in ['body', 'mind', 'spirit']
        && request.resource.data.videoId is string && request.resource.data.videoId.size() <= 20
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 300))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        && request.resource.data.size() <= 20;
    }
    // Activity: one document per session counting toward a ring: Watch and Scroll (timed, at most 4 hours each), or
    // logged by hand on the Rings page (at most 24 hours).
    match /users/{uid}/activity/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.ring in ['body', 'mind', 'spirit']
        && request.resource.data.source in ['watch', 'scroll', 'manual']
        && request.resource.data.seconds is number && request.resource.data.seconds >= 0
        && request.resource.data.seconds <= (request.resource.data.source == 'manual' ? 86400 : 14400)
        && request.resource.data.startedAt is number
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && request.resource.data.size() <= 12;
    }
    // The Scroll: one document per card, with its own counts (views, time on screen, liked, saved).
    match /users/{uid}/scroll/{cardId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000))
        && request.resource.data.size() <= 20;
    }
    // Settings, such as the ring goals. Pages listen to the whole (one-document) collection, so reading must not
    // depend on the document's name, or Firestore refuses the listen; writing is limited to the one document, 'main'.
    match /users/{uid}/prefs/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && docId == 'main';
    }
    // Nothing else can be read or written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
